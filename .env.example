# 阶跃星辰 OpenAI 兼容接口。真实密钥只放在本地 .env 或托管平台 Secret 中。
STEPFUN_BASE_URL=https://api.stepfun.com/step_plan/v1
STEPFUN_API_KEY=
STEPFUN_CHAT_MODEL=step-3.7-flash
STEPFUN_TIMEOUT_MS=20000
# StepFun 图像编辑用于个人页主体抠图增强；未配置时自动使用浏览器本地模型。
STEPFUN_IMAGE_BASE_URL=https://api.stepfun.com/v1
STEPFUN_IMAGE_MODEL=step-image-edit-2
STEPFUN_IMAGE_TIMEOUT_MS=65000
# GitHub Pages 可选的独立后端地址，例如 https://api.example.com。
# 这是公开地址，不是密钥；后端必须允许 GitHub Pages 域名跨域访问。
NEXT_PUBLIC_QIJING_API_BASE_URL=
